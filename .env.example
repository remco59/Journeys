# Copy to .env for local docker compose use.

# Postgres
POSTGRES_DB=journeys
POSTGRES_USER=journeys
POSTGRES_PASSWORD=journeys_dev_password
DATABASE_URL=postgres://journeys:journeys_dev_password@postgres:5432/journeys

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/data/photos

# S3 (only used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Auth
SESSION_COOKIE_NAME=journeys_session
SESSION_TTL_DAYS=30

# Bootstrap admin (used once, on first boot, if no admin user exists yet)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# Geocoding
GEOCODE_PROVIDER=photon
GEOCODE_BASE_URL=https://photon.komoot.io

# Map tiles
TILE_PROVIDER_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© OpenStreetMap contributors
